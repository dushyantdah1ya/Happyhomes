# Happy Homes Jaipur — Environment Variables Template

# Development Server URL
APP_URL=http://localhost:3000

# Client-Side Firebase Web Configuration (Public)
# Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Server-Side Firebase Admin Configuration (Private Secrets)
# Found in Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-Side Owner Authorization Allowlist (Private)
# Comma-separated list of authorized Firebase User IDs (UIDs). Empty or missing = NO access granted.
OWNER_FIREBASE_UID_ALLOWLIST=

# Server-Side Cloudinary Media Storage (Private Secrets - Never expose to client or VITE_*)
# Found in Cloudinary Console -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional signed upload preset for photographs (defaults to happy_homes_photos)
CLOUDINARY_UPLOAD_PRESET=happy_homes_photos
# Optional signed upload preset for PDF floor plans and brochures (defaults to happy_homes_documents)
CLOUDINARY_DOCUMENT_UPLOAD_PRESET=happy_homes_documents
